{
  "name": "@nandhaalagesan/zerogravity",
  "version": "1.2.5",
  "description": "Ultra-compact autonomous supercoder OS framework installer for Google Antigravity",
  "main": "bin/cli.js",
  "bin": {
    "zerogravity": "bin/cli.js",
    "zg": "bin/cli.js"
  },
  "files": [
    "bin/",
    ".agents/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/cli.js",
    "test": "node bin/cli.js --help",
    "prepack": "find . -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null; rm -rf .agents/cache/* 2>/dev/null",
    "pack:dry": "npm run prepack && npm pack --dry-run",
    "prepublishOnly": "npm run prepack && PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover tests -v && npm run prepack && node bin/cli.js --dry-run -y"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "antigravity",
    "zerogravity",
    "ai-agent",
    "supercoder",
    "mcp",
    "workflows",
    "developer-tools"
  ],
  "author": "Nandha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Myselfnandha/ZeroGravity.git"
  },
  "bugs": {
    "url": "https://github.com/Myselfnandha/ZeroGravity/issues"
  },
  "homepage": "https://github.com/Myselfnandha/ZeroGravity#readme",
  "engines": {
    "node": ">=16.0.0"
  }
}
